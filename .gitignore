# Environment
.env
.env.*
!.env.example
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Data (regenerate with data/collect.py)
data/raw/*
data/processed/*
data/*.csv
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# Scraped FOMC corpus (public domain, regenerate with llm/fomc_scraper.py)
data/fomc/

# LLM API call logs (may contain prompt/response payloads)
logs/*
!logs/.gitkeep

# Model artifacts
models/*.pkl
models/*.joblib
models/*.json
models/*.ubj

# Generated figures
viz/output/

# Local tooling state. Machine-specific, and settings.local.json can capture
# command lines that contained secrets.
.claude/

# Pipeline run log (regenerated by run_all.py)
logs/run_all.log

# OS / editor
.DS_Store
.vscode/
.idea/
